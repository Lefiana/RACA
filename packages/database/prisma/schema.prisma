// File: packages/database/prisma/schema.prisma
// Purpose: Full database schema — Better Auth owns user/session/account/verification tables.
//          App-specific fields (role, department, etc.) are extended on top of the Better Auth base.
//          All domain models reference the Better Auth "user" table via userId.
// Dependencies: Prisma ORM, PostgreSQL, better-auth/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  REQUESTOR
  ADVISER
  DEPARTMENT_HEAD
  MIS
  BUILDING_ADMIN
  HRM_CUSTODIAN
  STUDENT_AFFAIRS
  ACADEMIC_HEAD
  SCHOOL_ADMIN
  SUPER_ADMIN
}

enum RequestStatus {
  DRAFT
  PENDING
  STAGE1_REVIEW
  STAGE2_REVIEW
  PENDING_FINAL
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  REVISION_REQUESTED  // ← NEW
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  REVISION_REQUESTED  // ← NEW
  SUSPENDED           // ← NEW
}

enum ApprovalStage {
  STAGE_1_ADVISER
  STAGE_1_DEPT_HEAD
  STAGE_2_MIS
  STAGE_2_BUILDING
  STAGE_2_HEAD_OF_STUDENT_AFFAIRS
  STAGE_2_ACADEMIC_HEAD
  STAGE_3_SCHOOL_ADMIN
}

enum VenueStatus {
  AVAILABLE
  RESERVED
  MAINTENANCE
  BLOCKED
}

enum AssetCustodian {
  MIS
  BUILDING_ADMIN
  HRM_CUSTODIAN
}

enum AssetStatus {
  AVAILABLE
  RESERVED
  CHECKED_OUT
  MAINTENANCE
  LOST
  DAMAGED
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum CheckoutStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
  DAMAGED_ON_RETURN
}

// ─── NEW ENUMS ─────────────────────────────────────────────────────────────
enum ApprovalGroup {
  IT_CPE
  ART_SCIENCE
  THM_BM
  ASST_PRINCIPAL
  GEN_ED
}

enum RevisionType {
  REVISION_RESUME
  REVISION_RESTART
}
// ─────────────────────────────────────────────

enum NotificationType {
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  STAGE_ADVANCED
  STEP_APPROVED
  STEP_REJECTED
  ASSET_CHECKED_OUT
  ASSET_RETURNED
  ASSET_DUE
  ASSET_OVERDUE
  SYSTEM
  REVISION_REQUESTED  // ← NEW
}

// ─────────────────────────────────────────────
// BETTER AUTH CORE TABLES
// ─────────────────────────────────────────────

model User {
  // ── Required by Better Auth ───────────────────
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── App-specific extensions ───────────────────
  username    String?   @unique
  role        UserRole  @default(REQUESTOR)
  department  String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  deletedAt   DateTime?

  // ── NEW: Approval Group for Department Head routing ───────────────────
  approvalGroup ApprovalGroup?

  // ── Better Auth relations ─────────────────────
  sessions Session[]
  accounts Account[]

  // ── App relations ─────────────────────────────
  submittedRequests Request[]       @relation("RequestedBy")
  approvalSteps     ApprovalStep[]  @relation("ApproverSteps")
  uploadedFiles     Attachment[]    @relation("UploadedBy")
  notifications     Notification[]
  checkoutsHandled  AssetCheckout[] @relation("HandledBy")
  auditLogs         AuditLog[]      @relation("PerformedBy")

  @@index([role])
  @@index([deletedAt])
  @@index([approvalGroup])  // ← NEW
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

// ─────────────────────────────────────────────
// SYSTEM CONFIG
// ─────────────────────────────────────────────

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("system_configs")
}

// ─────────────────────────────────────────────
// REQUESTS — core RACA workflow
// ─────────────────────────────────────────────

model Request {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  requestedById   String

  // Section I
  activityTitle String
  theme         String?

  // Section II
  objectives String

  // Section III
  activityStartAt DateTime
  activityEndAt   DateTime

  // Section IV
  venueDescription     String?
  equipmentDescription String?

  // Section V
  speakers Json @default("[]")

  // Section VI
  expectedAudience  String?
  expectedHeadcount Int?

  remarks     String?
  status      RequestStatus @default(DRAFT)
  submittedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  // ── NEW: Approval Group + Revision tracking ───────────────────
  approvalGroup  ApprovalGroup?
  revisionCount  Int            @default(0)
  revisedAt      DateTime?
  previousStatus RequestStatus?

  requestedBy    User            @relation("RequestedBy", fields: [requestedById], references: [id])
  venueBookings  VenueBooking[]
  assetCheckouts AssetCheckout[]
  approvalSteps  ApprovalStep[]
  attachments    Attachment[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([requestedById])
  @@index([status])
  @@index([activityStartAt])
  @@index([referenceNumber])
  @@index([deletedAt])
  @@index([approvalGroup])  // ← NEW
  @@map("requests")
}

// ─────────────────────────────────────────────
// APPROVAL STEPS
// ─────────────────────────────────────────────

model ApprovalStep {
  id        String        @id @default(cuid())
  requestId String
  stage     ApprovalStage
  stepOrder Int

  approverId String?
  approver   User?   @relation("ApproverSteps", fields: [approverId], references: [id])

  approverName  String?
  approverRole  String?
  approverTitle String?

  status          ApprovalStatus @default(PENDING)
  remarks         String?
  rejectionReason String?
  decidedAt       DateTime?

  // ── NEW: Revision type tracking ───────────────────
  revisionType RevisionType?

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stage])
  @@index([requestId])
  @@index([approverId])
  @@index([status])
  @@map("approval_steps")
}

// ─────────────────────────────────────────────
// VENUES
// ─────────────────────────────────────────────

model Venue {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  building    String?
  floor       String?
  capacity    Int
  status      VenueStatus @default(AVAILABLE)
  features    String[]
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  bookings        VenueBooking[]
  maintenanceLogs MaintenanceLog[]

  @@index([status])
  @@index([deletedAt])
  @@map("venues")
}

model VenueBooking {
  id            String    @id @default(cuid())
  requestId     String
  venueId       String
  startAt       DateTime
  endAt         DateTime
  bufferStartAt DateTime
  bufferEndAt   DateTime
  isLocked      Boolean   @default(false)
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  venue   Venue   @relation(fields: [venueId], references: [id])

  @@index([venueId, startAt, endAt])
  @@index([requestId])
  @@map("venue_bookings")
}

// ─────────────────────────────────────────────
// ASSETS
// ─────────────────────────────────────────────

model Asset {
  id            String         @id @default(cuid())
  assetTag      String         @unique
  name          String
  description   String?
  category      String
  serialNumber  String?        @unique
  brand         String?
  model         String?
  status        AssetStatus    @default(AVAILABLE)
  condition     AssetCondition @default(GOOD)
  custodianRole  AssetCustodian @default(MIS)
  location      String?
  qrCode        String?
  purchasedAt   DateTime?
  warrantyUntil DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  checkouts       AssetCheckout[]
  maintenanceLogs MaintenanceLog[]

  @@index([status])
  @@index([category])
  @@index([assetTag])
  @@index([deletedAt])
  @@map("assets")
}

model AssetCheckout {
  id                String          @id @default(cuid())
  requestId         String
  assetId           String
  handledById       String?
  quantity          Int             @default(1)
  status            CheckoutStatus  @default(ACTIVE)
  checkedOutAt      DateTime?
  dueAt             DateTime?
  returnedAt        DateTime?
  conditionOnOut    AssetCondition?
  conditionOnReturn AssetCondition?
  damageNotes       String?
  penaltyNotes      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  asset     Asset   @relation(fields: [assetId], references: [id])
  handledBy User?   @relation("HandledBy", fields: [handledById], references: [id])

  @@index([requestId])
  @@index([assetId])
  @@index([status])
  @@index([dueAt])
  @@map("asset_checkouts")
}

// ─────────────────────────────────────────────
// MAINTENANCE LOGS
// ─────────────────────────────────────────────

model MaintenanceLog {
  id          String    @id @default(cuid())
  venueId     String?
  assetId     String?
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  resolvedAt  DateTime?
  loggedById  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  venue Venue? @relation(fields: [venueId], references: [id])
  asset Asset? @relation(fields: [assetId], references: [id])

  @@index([venueId])
  @@index([assetId])
  @@map("maintenance_logs")
}

// ─────────────────────────────────────────────
// ATTACHMENTS
// ─────────────────────────────────────────────

model Attachment {
  id             String  @id @default(cuid())
  requestId      String?
  approvalStepId String?
  uploadedById   String

  originalName String
  storedName   String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  label        String?

  createdAt DateTime @default(now())

  request      Request?      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approvalStep ApprovalStep? @relation(fields: [approvalStepId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation("UploadedBy", fields: [uploadedById], references: [id])

  @@index([requestId])
  @@index([approvalStepId])
  @@map("attachments")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  requestId String?
  stepId    String?
  type      NotificationType
  title     String
  body      String
  metadata  Json             @default("{}")
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  request Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([requestId])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  performedById String?
  requestId     String?
  action        String
  entity        String
  entityId      String?
  snapshot      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  performedBy User?    @relation("PerformedBy", fields: [performedById], references: [id], onDelete: SetNull)
  request     Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([performedById])
  @@index([requestId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}